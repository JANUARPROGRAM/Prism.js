{
  "name": "prism.js",
  "version": "0.2.0",
  "description": "A lightweight JavaScript 3D rendering engine built from scratch on top of WebGL/WebGL2.",
  "keywords": ["3d", "webgl", "webgl2", "graphics", "rendering", "engine"],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/prism.min.js",
  "jsdelivr": "./dist/prism.min.js",
  "sideEffects": false,
  "files": ["src", "dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/serve.js",
    "test": "node --test",
    "build": "esbuild src/index.js --bundle --format=esm --minify --sourcemap --outfile=dist/prism.module.js && esbuild src/index.js --bundle --format=iife --global-name=Prism --minify --sourcemap --outfile=dist/prism.min.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.27.7"
  }
}
